{
    "name": "Relatos de papel",
    "build": {
        "dockerfile": "Dockerfile"        
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "moby": "false"            
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint"
            ]
        }
    },
    "postCreateCommand": "npm install",
    "remoteUser": "node"
}